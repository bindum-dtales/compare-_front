# Frontend API configuration (lib/config/api.ts). Copy to .env.local for development, or set in the
# build environment for production. Both values are baked in by `next build`: setting them only for
# `next start` has no effect, so rebuild after changing them.
#
# Never put backend secrets (Supabase, Groq, Tavily, Jina keys) here: they belong in back/.env only.
# NEXT_PUBLIC_* values are copied into the browser bundle and are visible to every visitor.

# --- Proxy mode (default; needs `next start`, i.e. a Node.js server) -------------------------------
# The browser calls same-origin /api/*; the Next server forwards it to this origin (no path).
# Development default: http://localhost:4000. Required for `npm run build`; must be https unless the
# backend runs on the same machine (http://127.0.0.1:4000).
# BACKEND_URL=https://api.example.com

# --- Direct mode (only if the frontend is served as static files with no Next server) --------------
# The browser calls this origin itself; the backend must list the frontend origin in FRONTEND_URL.
# Set this OR BACKEND_URL, not both. Must be a public https origin in a production build.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Optional: serve the bundled sample companies instead of the backend (demo / walkthrough).
# NEXT_PUBLIC_DEMO_DATA=1

# Optional, dev server only: extra hostnames allowed to reach `next dev` (named Cloudflare tunnel).
# DEV_ORIGINS=compare.example.com
